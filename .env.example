# Nakili faili hili kuwa ".env" kwa majaribio ya ndani (au weka vigezo hivi kwenye Render).

SECRET_KEY=badilisha-hii-iwe-ndefu-na-ya-siri
DEBUG=0
ALLOWED_HOSTS=nomadexplorertours.com,www.nomadexplorertours.com
CSRF_TRUSTED_ORIGINS=https://nomadexplorertours.com,https://www.nomadexplorertours.com
SITE_URL=https://www.nomadexplorertours.com

# Supabase > Connect > "Session pooler" connection string (port 5432)
DATABASE_URL=postgresql://postgres.xxxx:NENOSIRI@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Supabase > Storage: tengeneza bucket "nomad" (Public). Kisha Storage > Settings > S3 access keys
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_BUCKET=nomad
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_REGION=eu-central-1

# Msimamizi wa kwanza wa dashboard (anatengenezwa wakati wa deploy kama hayupo)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=

# Barua pepe ya kumjulisha mteja enquiry mpya ikiingia (hiari)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
ENQUIRY_NOTIFY_EMAIL=info@nomadexplorertours.com
